// Password spray detection across Entra ID sign-in logs.
// Flags source IPs that attempt to authenticate against >= 10 distinct user
// accounts with failure within a 30-minute window — a hallmark of low-and-slow
// password-spray operations (MITRE T1110.003).
SigninLogs
| where TimeGenerated > ago(1d)
| where ResultType in ("50126", "50053", "50055", "50056")
| summarize
    DistinctUsers      = dcount(UserPrincipalName),
    FailedAttempts     = count(),
    SampleUsers        = make_set(UserPrincipalName, 10),
    Apps               = make_set(AppDisplayName, 5),
    FirstSeen          = min(TimeGenerated),
    LastSeen           = max(TimeGenerated)
    by IPAddress, bin(TimeGenerated, 30m)
| where DistinctUsers >= 10
| extend Severity = case(DistinctUsers >= 50, "high", DistinctUsers >= 20, "medium", "low")
| project FirstSeen, LastSeen, IPAddress, DistinctUsers, FailedAttempts, Severity, Apps, SampleUsers
| order by DistinctUsers desc
